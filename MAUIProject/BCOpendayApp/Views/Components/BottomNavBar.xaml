<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BCOpendayApp.Views.Components.BottomNavBar">
    <Grid BackgroundColor="#0D0D0D" ColumnDefinitions="*,*,*" ColumnSpacing="4" Padding="8,10">
        <Button x:Name="HomeButton" Grid.Column="0" Text="Home" Clicked="OnHomeClicked" MinimumHeightRequest="48" Padding="2,10" FontSize="13" TextColor="White" />
        <Button x:Name="TourButton" Grid.Column="1" Text="Tour" Clicked="OnTourClicked" MinimumHeightRequest="48" Padding="2,10" FontSize="13" TextColor="White" />
        <Button x:Name="MapButton" Grid.Column="2" Text="Map" Clicked="OnMapClicked" MinimumHeightRequest="48" Padding="2,10" FontSize="13" TextColor="White" />
    </Grid>
</ContentView>
