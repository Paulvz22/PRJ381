<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BCOpendayApp.Views.MapPage"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="MapPage">

    <Grid RowDefinitions="64,*">

        <!-- ========================= -->
        <!-- HEADER BAR -->
        <!-- ========================= -->
        <Grid Grid.Row="0"
              BackgroundColor="#0D0D0D"
              Padding="16,0"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              ColumnSpacing="14">

            <Image Grid.Column="0"
                   Source="hamburger_menu.png"
                   WidthRequest="26"
                   HeightRequest="26"
                   VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="-4">
                <Label Text="BELGIUM CAMPUS"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold" />
                <Label Text="AR TOUR"
                       TextColor="#F82B2E"
                       FontSize="18"
                       FontAttributes="Bold" />
            </VerticalStackLayout>

            <!-- Bell with red notification dot -->
            <Grid Grid.Column="3"
                  WidthRequest="34"
                  HeightRequest="34"
                  VerticalOptions="Center">
                <Image Source="bell.png"
                       WidthRequest="26"
                       HeightRequest="26" />
                <BoxView Color="#F82B2E"
                         CornerRadius="5"
                         WidthRequest="10"
                         HeightRequest="10"
                         HorizontalOptions="End"
                         VerticalOptions="Start" />
            </Grid>

            <Image Grid.Column="4"
                   Source="icon_profile.png"
                   WidthRequest="36"
                   HeightRequest="36"
                   VerticalOptions="Center" />

        </Grid>

        <!-- ========================= -->
        <!-- CONTENT: MAP CARD + KEY PANEL -->
        <!-- ========================= -->
        <Grid Grid.Row="1"
              Padding="14"
              ColumnDefinitions="2*,*"
              ColumnSpacing="14">

            <!-- ===== MAP CARD ===== -->
            <Border Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E3E3E3"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="0">

                <Grid>

                    <!-- Map image + pins -->
                    <AbsoluteLayout>

                        <Image x:Name="CampusMapImage"
                               Source="campus_map_main.png"
                               Aspect="AspectFit"
                               AbsoluteLayout.LayoutBounds="0,0,1,1"
                               AbsoluteLayout.LayoutFlags="All" />

                        <!-- Pins for the Main map (hidden on North / West) -->
                        <AbsoluteLayout x:Name="MainPins"
                                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                                        AbsoluteLayout.LayoutFlags="All">

                            <!-- Library pin -->
                            <Image Source="pin_red.png"
                                   AbsoluteLayout.LayoutBounds="0.51,0.10,26,34"
                                   AbsoluteLayout.LayoutFlags="PositionProportional">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Library" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Reception pin -->
                            <Image Source="pin_red.png"
                                   AbsoluteLayout.LayoutBounds="0.68,0.04,26,34"
                                   AbsoluteLayout.LayoutFlags="PositionProportional">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Reception" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Classroom Alpha pin -->
                            <Image Source="pin_red.png"
                                   AbsoluteLayout.LayoutBounds="0.32,0.11,26,34"
                                   AbsoluteLayout.LayoutFlags="PositionProportional">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Classroom Alpha" />
                                </Image.GestureRecognizers>
                            </Image>

                        </AbsoluteLayout>

                    </AbsoluteLayout>

                    <!-- Title card (top left) -->
                    <Border BackgroundColor="#111111"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,10"
                            Margin="14"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="12">
                            <Image Source="pin_red.png"
                                   WidthRequest="22"
                                   HeightRequest="30"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="MapTitleLabel"
                                       Text="Main Campus Map"
                                       TextColor="White"
                                       FontSize="17"
                                       FontAttributes="Bold" />
                                <Label Text="Explore. Discover. Belong."
                                       TextColor="#CFCFCF"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Section switcher (top right) -->
                    <Border BackgroundColor="#111111"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="4"
                            Margin="14"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="2">

                            <Button x:Name="MainTab"
                                    Text="Main"
                                    Clicked="OnSectionSwitched"
                                    CommandParameter="main"
                                    BackgroundColor="Transparent"
                                    TextColor="#F82B2E"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="12,0"
                                    HeightRequest="34" />

                            <Button x:Name="NorthTab"
                                    Text="North"
                                    Clicked="OnSectionSwitched"
                                    CommandParameter="north"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="12,0"
                                    HeightRequest="34" />

                            <Button x:Name="WestTab"
                                    Text="West"
                                    Clicked="OnSectionSwitched"
                                    CommandParameter="west"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="12,0"
                                    HeightRequest="34" />

                        </HorizontalStackLayout>
                    </Border>

                    <!-- Compass (bottom left) -->
                    <Border BackgroundColor="#111111"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30"
                            WidthRequest="60"
                            HeightRequest="60"
                            Margin="14"
                            HorizontalOptions="Start"
                            VerticalOptions="End">
                        <Grid>
                            <Label Text="N" TextColor="White" FontSize="9" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                            <Label Text="S" TextColor="White" FontSize="9" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,4" />
                            <Label Text="W" TextColor="White" FontSize="9" FontAttributes="Bold"
                                   HorizontalOptions="Start" VerticalOptions="Center" Margin="7,0,0,0" />
                            <Label Text="E" TextColor="White" FontSize="9" FontAttributes="Bold"
                                   HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,7,0" />
                            <Label Text="▲" TextColor="White" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- ===== KEY PANEL ===== -->
            <Border Grid.Column="1"
                    BackgroundColor="#0D0D0D"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="0">

                <ScrollView>
                    <VerticalStackLayout Padding="20" Spacing="14">

                        <Label Text="Key"
                               TextColor="White"
                               FontSize="28"
                               FontAttributes="Bold" />

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- Key rows -->
                        <Grid ColumnDefinitions="44,*">
                            <Image Grid.Column="0" Source="pin_red.png"
                                   WidthRequest="22" HeightRequest="30" HorizontalOptions="Start" />
                            <Label Grid.Column="1" Text="Your Location" TextColor="White"
                                   FontSize="15" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="44,*">
                            <Border Grid.Column="0" BackgroundColor="#F82B2E" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6" WidthRequest="30" HeightRequest="30"
                                    HorizontalOptions="Start" />
                            <Label Grid.Column="1" Text="Classrooms" TextColor="White"
                                   FontSize="15" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="44,*">
                            <Border Grid.Column="0" BackgroundColor="#ECB000" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6" WidthRequest="30" HeightRequest="30"
                                    HorizontalOptions="Start" />
                            <Label Grid.Column="1" Text="Residences" TextColor="White"
                                   FontSize="15" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="44,*">
                            <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6" WidthRequest="30" HeightRequest="30"
                                    HorizontalOptions="Start" />
                            <Label Grid.Column="1" Text="Other Buildings" TextColor="White"
                                   FontSize="15" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="44,*">
                            <Border Grid.Column="0" BackgroundColor="#D1D3D4" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6" WidthRequest="30" HeightRequest="30"
                                    HorizontalOptions="Start" />
                            <Label Grid.Column="1" Text="Outdoor Areas" TextColor="White"
                                   FontSize="15" VerticalOptions="Center" />
                        </Grid>

                        <!-- Quick Access -->
                        <Label Text="Quick Access"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"
                               Margin="0,10,0,0" />

                        <!-- Library -->
                        <Border BackgroundColor="#141414" Stroke="#3A3A3A" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Library" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="qa_library.png"
                                       WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Library" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Books, study spaces, resources" TextColor="#B8B8B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="White" FontSize="28" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- IT Lab -->
                        <Border BackgroundColor="#141414" Stroke="#3A3A3A" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="IT Lab" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="qa_itlab.png"
                                       WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="IT Lab" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Computers, software, technical support" TextColor="#B8B8B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="White" FontSize="28" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Cafeteria -->
                        <Border BackgroundColor="#141414" Stroke="#3A3A3A" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Cafeteria" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="qa_cafeteria.png"
                                       WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Cafeteria" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Food, drinks, seating" TextColor="#B8B8B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="White" FontSize="28" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Gym -->
                        <Border BackgroundColor="#141414" Stroke="#3A3A3A" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Gym" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="qa_gym.png"
                                       WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Gym" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Fitness, wellness" TextColor="#B8B8B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="White" FontSize="28" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Student Lounge -->
                        <Border BackgroundColor="#141414" Stroke="#3A3A3A" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinTapped" CommandParameter="Student Lounge" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="qa_lounge.png"
                                       WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="Start" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Student Lounge" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="Relax, meet, connect" TextColor="#B8B8B8" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" TextColor="White" FontSize="28" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Back to Main Menu -->
                        <Border BackgroundColor="#F82B2E"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="48"
                                Margin="0,6,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToMenuTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="10">
                                <Image Source="icon_map_white.png"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       VerticalOptions="Center" />
                                <Label Text="Back to Main Menu"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>

        </Grid>

    </Grid>

</ContentPage>