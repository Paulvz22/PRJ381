<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BCOpendayApp.Views.MapPage"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="MapPage">

    <Grid RowDefinitions="60,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              BackgroundColor="#0D0D0D"
              Padding="10,0"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="10">

            <!-- Hamburger -->
            <Image Grid.Column="0"
                   Source="hamburger_menu.png"
                   WidthRequest="25"
                   HeightRequest="25"
                   VerticalOptions="Center" />

            <!-- Belgium Campus / AR Tour -->
            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="-3">

                <Label Text="BELGIUM CAMPUS"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold" />

                <Label Text="AR TOUR"
                       TextColor="#F82B2E"
                       FontSize="16"
                       FontAttributes="Bold" />

            </VerticalStackLayout>

            <!-- Notification -->
            <Grid Grid.Column="2"
                  WidthRequest="30"
                  HeightRequest="30"
                  VerticalOptions="Center">

                <Image Source="bell.png"
                       WidthRequest="23"
                       HeightRequest="23" />

                <BoxView Color="#F82B2E"
                         CornerRadius="5"
                         WidthRequest="9"
                         HeightRequest="9"
                         HorizontalOptions="End"
                         VerticalOptions="Start" />

            </Grid>

            <!-- Profile -->
            <Image Grid.Column="3"
                   Source="icon_profile.png"
                   WidthRequest="31"
                   HeightRequest="31"
                   VerticalOptions="Center" />

        </Grid>


        <!-- ================================================= -->
        <!-- PHONE CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="8"
                                 Spacing="10">


                <!-- ================================================= -->
                <!-- MAP CARD -->
                <!-- ================================================= -->

                <Border BackgroundColor="White"
                        Stroke="#E3E3E3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="8">

                    <VerticalStackLayout Spacing="8">


                        <!-- ========================================= -->
                        <!-- MAP TITLE -->
                        <!-- ========================================= -->

                        <Border BackgroundColor="#111111"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11"
                                Padding="10,7"
                                HorizontalOptions="Fill">

                            <HorizontalStackLayout Spacing="8">

                                <Image Source="pin_red.png"
                                       WidthRequest="19"
                                       HeightRequest="26"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Spacing="-1"
                                                     VerticalOptions="Center">

                                    <Label x:Name="MapTitleLabel"
                                           Text="Main Campus Map"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Explore. Discover. Belong."
                                           TextColor="#CFCFCF"
                                           FontSize="9" />

                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                        </Border>


                        <!-- ========================================= -->
                        <!-- MAIN / NORTH / WEST NAVIGATION -->
                        <!-- ========================================= -->

                        <Border BackgroundColor="#111111"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="2"
                                HorizontalOptions="Center">

                            <HorizontalStackLayout Spacing="0">

                                <Button x:Name="MainTab"
                                        Text="Main"
                                        Clicked="OnSectionSwitched"
                                        CommandParameter="main"
                                        BackgroundColor="Transparent"
                                        TextColor="#F82B2E"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Padding="15,0"
                                        HeightRequest="30" />

                                <Button x:Name="NorthTab"
                                        Text="North"
                                        Clicked="OnSectionSwitched"
                                        CommandParameter="north"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Padding="15,0"
                                        HeightRequest="30" />

                                <Button x:Name="WestTab"
                                        Text="West"
                                        Clicked="OnSectionSwitched"
                                        CommandParameter="west"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Padding="15,0"
                                        HeightRequest="30" />

                            </HorizontalStackLayout>

                        </Border>


                        <!-- ========================================= -->
                        <!-- MAP IMAGE AREA -->
                        <!-- ========================================= -->

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="0">

                            <Grid HeightRequest="300">

                                <!-- ================================= -->
                                <!-- MAP IMAGE -->
                                <!-- ================================= -->

                                <AbsoluteLayout>

                                    <Image x:Name="CampusMapImage"
                                           Source="campus_map_main.png"
                                           Aspect="AspectFit"
                                           AbsoluteLayout.LayoutBounds="0,0,1,1"
                                           AbsoluteLayout.LayoutFlags="All" />


                                    <!-- ================================= -->
                                    <!-- MAP PINS -->
                                    <!-- ================================= -->

                                    <AbsoluteLayout x:Name="MainPins"
                                                    AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                    AbsoluteLayout.LayoutFlags="All">

                                        <!-- Library -->
                                        <Image Source="pin_red.png"
                                               AbsoluteLayout.LayoutBounds="0.51,0.10,26,34"
                                               AbsoluteLayout.LayoutFlags="PositionProportional">

                                            <Image.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Tapped="OnPinTapped"
                                                    CommandParameter="Library" />

                                            </Image.GestureRecognizers>

                                        </Image>


                                        <!-- Reception -->
                                        <Image Source="pin_red.png"
                                               AbsoluteLayout.LayoutBounds="0.68,0.04,26,34"
                                               AbsoluteLayout.LayoutFlags="PositionProportional">

                                            <Image.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Tapped="OnPinTapped"
                                                    CommandParameter="Reception" />

                                            </Image.GestureRecognizers>

                                        </Image>


                                        <!-- Classroom Alpha -->
                                        <Image Source="pin_red.png"
                                               AbsoluteLayout.LayoutBounds="0.32,0.11,26,34"
                                               AbsoluteLayout.LayoutFlags="PositionProportional">

                                            <Image.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Tapped="OnPinTapped"
                                                    CommandParameter="Classroom Alpha" />

                                            </Image.GestureRecognizers>

                                        </Image>

                                    </AbsoluteLayout>

                                </AbsoluteLayout>


                                <!-- ================================= -->
                                <!-- COMPASS -->
                                <!-- ================================= -->

                                <Border BackgroundColor="#111111"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 25"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        Margin="8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="End">

                                    <Grid>

                                        <Label Text="N"
                                               TextColor="White"
                                               FontSize="8"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Start"
                                               Margin="0,3,0,0" />

                                        <Label Text="S"
                                               TextColor="White"
                                               FontSize="8"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="End"
                                               Margin="0,0,0,3" />

                                        <Label Text="W"
                                               TextColor="White"
                                               FontSize="8"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center"
                                               Margin="6,0,0,0" />

                                        <Label Text="E"
                                               TextColor="White"
                                               FontSize="8"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               Margin="0,0,6,0" />

                                        <Label Text="▲"
                                               TextColor="White"
                                               FontSize="14"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- KEY PANEL -->
                <!-- ================================================= -->

                <Border BackgroundColor="#0D0D0D"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">

                    <VerticalStackLayout Spacing="12">


                        <!-- KEY TITLE -->

                        <Label Text="Key"
                               TextColor="White"
                               FontSize="25"
                               FontAttributes="Bold" />

                        <BoxView HeightRequest="1"
                                 Color="#333333" />


                        <!-- YOUR LOCATION -->

                        <Grid ColumnDefinitions="38,*">

                            <Image Grid.Column="0"
                                   Source="pin_red.png"
                                   WidthRequest="20"
                                   HeightRequest="27"
                                   HorizontalOptions="Start" />

                            <Label Grid.Column="1"
                                   Text="Your Location"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                        </Grid>


                        <!-- CLASSROOMS -->

                        <Grid ColumnDefinitions="38,*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#F82B2E"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    WidthRequest="27"
                                    HeightRequest="27"
                                    HorizontalOptions="Start" />

                            <Label Grid.Column="1"
                                   Text="Classrooms"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                        </Grid>


                        <!-- RESIDENCES -->

                        <Grid ColumnDefinitions="38,*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#ECB000"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    WidthRequest="27"
                                    HeightRequest="27"
                                    HorizontalOptions="Start" />

                            <Label Grid.Column="1"
                                   Text="Residences"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                        </Grid>


                        <!-- OTHER BUILDINGS -->

                        <Grid ColumnDefinitions="38,*">

                            <Border Grid.Column="0"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    WidthRequest="27"
                                    HeightRequest="27"
                                    HorizontalOptions="Start" />

                            <Label Grid.Column="1"
                                   Text="Other Buildings"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                        </Grid>


                        <!-- OUTDOOR AREAS -->

                        <Grid ColumnDefinitions="38,*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#D1D3D4"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    WidthRequest="27"
                                    HeightRequest="27"
                                    HorizontalOptions="Start" />

                            <Label Grid.Column="1"
                                   Text="Outdoor Areas"
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                        </Grid>


                        <!-- ================================================= -->
                        <!-- QUICK ACCESS -->
                        <!-- ================================================= -->

                        <Label Text="Quick Access"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               Margin="0,8,0,0" />


                        <!-- LIBRARY -->

                        <Border BackgroundColor="#141414"
                                Stroke="#3A3A3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="11">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnPinTapped"
                                    CommandParameter="Library" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="38,*,Auto"
                                  ColumnSpacing="8">

                                <Image Grid.Column="0"
                                       Source="qa_library.png"
                                       WidthRequest="27"
                                       HeightRequest="27"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0"
                                                     VerticalOptions="Center">

                                    <Label Text="Library"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Books, study spaces, resources"
                                           TextColor="#B8B8B8"
                                           FontSize="11" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       TextColor="White"
                                       FontSize="25"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Border>


                        <!-- IT LAB -->

                        <Border BackgroundColor="#141414"
                                Stroke="#3A3A3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="11">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnPinTapped"
                                    CommandParameter="IT Lab" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="38,*,Auto"
                                  ColumnSpacing="8">

                                <Image Grid.Column="0"
                                       Source="qa_itlab.png"
                                       WidthRequest="27"
                                       HeightRequest="27"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0"
                                                     VerticalOptions="Center">

                                    <Label Text="IT Lab"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Computers, software, technical support"
                                           TextColor="#B8B8B8"
                                           FontSize="11" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       TextColor="White"
                                       FontSize="25"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Border>


                        <!-- CAFETERIA -->

                        <Border BackgroundColor="#141414"
                                Stroke="#3A3A3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="11">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnPinTapped"
                                    CommandParameter="Cafeteria" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="38,*,Auto"
                                  ColumnSpacing="8">

                                <Image Grid.Column="0"
                                       Source="qa_cafeteria.png"
                                       WidthRequest="27"
                                       HeightRequest="27"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0"
                                                     VerticalOptions="Center">

                                    <Label Text="Cafeteria"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Food, drinks, seating"
                                           TextColor="#B8B8B8"
                                           FontSize="11" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       TextColor="White"
                                       FontSize="25"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Border>


                        <!-- GYM -->

                        <Border BackgroundColor="#141414"
                                Stroke="#3A3A3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="11">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnPinTapped"
                                    CommandParameter="Gym" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="38,*,Auto"
                                  ColumnSpacing="8">

                                <Image Grid.Column="0"
                                       Source="qa_gym.png"
                                       WidthRequest="27"
                                       HeightRequest="27"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0"
                                                     VerticalOptions="Center">

                                    <Label Text="Gym"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Fitness, wellness"
                                           TextColor="#B8B8B8"
                                           FontSize="11" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       TextColor="White"
                                       FontSize="25"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Border>


                        <!-- STUDENT LOUNGE -->

                        <Border BackgroundColor="#141414"
                                Stroke="#3A3A3A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 13"
                                Padding="11">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnPinTapped"
                                    CommandParameter="Student Lounge" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="38,*,Auto"
                                  ColumnSpacing="8">

                                <Image Grid.Column="0"
                                       Source="qa_lounge.png"
                                       WidthRequest="27"
                                       HeightRequest="27"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0"
                                                     VerticalOptions="Center">

                                    <Label Text="Student Lounge"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Label Text="Relax, meet, connect"
                                           TextColor="#B8B8B8"
                                           FontSize="11" />

                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       TextColor="White"
                                       FontSize="25"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- BACK TO MAIN MENU -->
                        <!-- ================================================= -->

                        <Border BackgroundColor="#F82B2E"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="46"
                                Margin="0,3,0,4">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="OnBackToMenuTapped" />

                            </Border.GestureRecognizers>

                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="8">

                                <Image Source="icon_map_white.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />

                                <Label Text="Back to Main Menu"
                                       TextColor="White"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />

                            </HorizontalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>