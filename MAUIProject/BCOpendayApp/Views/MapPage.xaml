<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BCOpendayApp.Views.MapPage"
             Title="MapPage">

    <AbsoluteLayout>

        <!--Background campus map image -->
        <Image Source="campus_map_main.png"
               Aspect="AspectFit"
               AbsoluteLayout.LayoutBounds="0,0,1,1"
               AbsoluteLayout.LayoutFlags="All" />

        <!-- Library pin -->
        <Button Text="📍"
                FontSize="20"
                BackgroundColor="Transparent"
                AbsoluteLayout.LayoutBounds="0.45,0.25,40,40"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OnPinTapped"
                CommandParameter="Library" />

        <!-- Reception pin -->
        <Button Text="📍"
                FontSize="20"
                BackgroundColor="Transparent"
                AbsoluteLayout.LayoutBounds="0.55,0.14,40,40"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OnPinTapped"
                CommandParameter="Reception" />

        <!-- Classroom Alpha pin -->
        <Button Text="📍"
            FontSize="20"
            BackgroundColor="Transparent"
            AbsoluteLayout.LayoutBounds="0.38,0.20,40,40"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            Clicked="OnPinTapped"
            CommandParameter="Classroom Alpha" />

    </AbsoluteLayout>

</ContentPage>