<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only nuget.org. Clearing inherited sources stops a stale, offline or private feed on one
         teammate's machine (e.g. left over from the Unity/Firebase attempts) from breaking restore. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- OPTIONAL - only if "path too long" errors still happen after following the README:
       move the NuGet cache to a short folder. Easiest is the NUGET_PACKAGES environment variable
       (e.g. C:\nuget); alternatively uncomment this and use an ABSOLUTE short path.
       Do not use a path inside a deep project folder - that makes the problem worse.

  <config>
    <add key="globalPackagesFolder" value="C:\nuget\packages" />
  </config>
  -->
</configuration>
