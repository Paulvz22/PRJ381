# ==========================================
# 1. VISUAL STUDIO & SYSTEM DEPLOYMENTS
# ==========================================
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.suo
Thumbs.db
.DS_Store

# ==========================================
# 2. .NET MAUI / VISUAL STUDIO BINARIES
# ==========================================
# Exclude compilation output folders
[Bb]in/
[Oo]bj/
Generated\ Files/

# Exclude generated deployment packages
*.apk
*.ap_
*.dex

# ==========================================
# 3. UNITY ENGINE GENERATED FILES
# ==========================================
# Exclude dynamic engine locks, metrics, and asset caches
UnityProject/Library/
UnityProject/Temp/
UnityProject/Obj/
UnityProject/Build/
UnityProject/Builds/
UnityProject/Logs/
UnityProject/UserSettings/
MemoryCaptures/
RecordingBackups/

# Exclude tracking files built on editor start
UnityProject/Assets/AssetStoreTools*

# Exclude editor scratch files
*.tmp
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Exclude Unity internal build deployment manifests
*.assetbundle
*.manifest

# ==========================================
# 4. EXPLICIT PRESERVATION RULES
# ==========================================
# Ensure Git NEVER ignores your .sln, .slnx, or .csproj files inside MAUIProject
!MAUIProject/*.sln
!MAUIProject/*.slnx
!MAUIProject/**/*.csproj

# Ensure Git tracks the critical binding library needed to link Unity to MAUI
!MAUIProject/UnityAndroidBinding/Jars/*.jar
!MAUIProject/UnityAndroidBinding/Jars/*.aar