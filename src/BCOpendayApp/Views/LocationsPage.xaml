<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BCOpendayApp.Views.LocationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BCOpendayApp.Views.Controls"
    xmlns:views="clr-namespace:BCOpendayApp.Views"
    xmlns:vm="clr-namespace:BCOpendayApp.ViewModels"
    x:DataType="vm:LocationsViewModel"
    Title="Locations"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <controls:PageHeader Title="Campus locations" Subtitle="{Binding Subtitle}" />

            <ActivityIndicator IsRunning="{Binding ShowSpinner}" IsVisible="{Binding ShowSpinner}" Color="{StaticResource BcRed}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" FontSize="13" />

            <VerticalStackLayout Spacing="18" IsVisible="{Binding HasLocations}">
                <SearchBar Placeholder="Search locations or codes" Text="{Binding SearchText}" />

                <Label
                    Text="No locations match your search."
                    Style="{StaticResource MutedLabel}"
                    IsVisible="{Binding HasNoResults}" />

                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding Items}"
                    BindableLayout.ItemTemplate="{StaticResource LocationRowTemplate}" />
            </VerticalStackLayout>

            <Button
                Text="Refresh"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding RefreshCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
