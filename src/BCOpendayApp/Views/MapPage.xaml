<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BCOpendayApp.Views.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BCOpendayApp.Views.Controls"
    xmlns:views="clr-namespace:BCOpendayApp.Views"
    xmlns:vm="clr-namespace:BCOpendayApp.ViewModels"
    x:DataType="vm:MapViewModel"
    Title="Map"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <controls:PageHeader Title="Campus map" Subtitle="Plan your next stop." />

            <VerticalStackLayout Spacing="18">

                <Label Text="{Binding MapTitle}" Style="{StaticResource SectionTitleLabel}" />

                <!-- Section switcher. The "main"/"north"/"west" ids come from CampusCatalog.Maps. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button
                        Grid.Column="0"
                        Text="Main"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="main">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSectionId}" Value="main">
                                <Setter Property="BackgroundColor" Value="{StaticResource BcRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="North"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="north">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSectionId}" Value="north">
                                <Setter Property="BackgroundColor" Value="{StaticResource BcRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Text="West"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="west">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSectionId}" Value="west">
                                <Setter Property="BackgroundColor" Value="{StaticResource BcRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Pan by scrolling, zoom with the slider. The canvas size and the image are laid out in
                     MapPage.xaml.cs. (The numbered pins were removed: docs/backups/restore-map-pins.patch.) -->
                <Border Style="{StaticResource Card}" Padding="8">
                    <ScrollView x:Name="MapViewport" Orientation="Both" HeightRequest="420">
                        <AbsoluteLayout
                            x:Name="MapCanvas"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                            <Image
                                x:Name="MapImage"
                                Aspect="Fill"
                                SemanticProperties.Description="Campus map" />
                        </AbsoluteLayout>
                    </ScrollView>
                </Border>

                <Label Text="Map zoom" Style="{StaticResource SectionTitleLabel}" FontSize="16" />
                <Slider
                    Minimum="1"
                    Maximum="3"
                    Value="{Binding Zoom}"
                    SemanticProperties.Description="Campus map zoom" />
                <Button
                    Text="Reset map zoom"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetZoomCommand}" />

                <Label Text="Campus locations" Style="{StaticResource SectionTitleLabel}" />
                <ActivityIndicator IsRunning="{Binding ShowSpinner}" IsVisible="{Binding ShowSpinner}" Color="{StaticResource BcRed}" />
                <Label
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource MutedLabel}"
                    FontSize="13"
                    IsVisible="{Binding HasNoLocations}" />
                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding Items}"
                    BindableLayout.ItemTemplate="{StaticResource LocationRowTemplate}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
