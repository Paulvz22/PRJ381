<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BCOpendayApp.Views.TourPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BCOpendayApp.Views.Controls"
    xmlns:views="clr-namespace:BCOpendayApp.Views"
    xmlns:vm="clr-namespace:BCOpendayApp.ViewModels"
    x:DataType="vm:TourViewModel"
    Title="Tour"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <controls:PageHeader Title="Your campus tour" Subtitle="{Binding Subtitle}" />

            <controls:CatalogStatusView />

            <VerticalStackLayout Spacing="18" IsVisible="{Binding HasCatalogue}">

                <Label
                    Text="This version is a photo and information tour. Camera AR, QR scanning and 360° scenes are coming soon."
                    Style="{StaticResource MutedLabel}" />

                <Label Text="{Binding ProgressText}" Style="{StaticResource CardTitleLabel}" FontSize="23" />
                <ProgressBar Progress="{Binding Progress}" />

                <Button
                    Text="{Binding ContinueText}"
                    Command="{Binding ContinueCommand}"
                    IsVisible="{Binding HasNextStop}" />
                <Label
                    Text="Tour complete! Explore your favourite stops again."
                    Style="{StaticResource CardTitleLabel}"
                    TextColor="{StaticResource BcRed}"
                    FontSize="19"
                    IsVisible="{Binding IsTourComplete}" />

                <VerticalStackLayout
                    Spacing="14"
                    BindableLayout.ItemsSource="{Binding Stops}"
                    BindableLayout.ItemTemplate="{StaticResource StopCardTemplate}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
