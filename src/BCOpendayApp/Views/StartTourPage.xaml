<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BCOpendayApp.Views.StartTourPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BCOpendayApp.Views.Controls"
    xmlns:views="clr-namespace:BCOpendayApp.Views"
    xmlns:vm="clr-namespace:BCOpendayApp.ViewModels"
    x:DataType="vm:StartTourViewModel"
    Title="Tour"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <controls:PageHeader Title="Start Tour" Subtitle="Explore the campus with the AR camera or 360° views." />

            <Border Style="{StaticResource Card}" Stroke="{StaticResource BcRedBrush}" StrokeThickness="2">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Image
                        Source="campus_entrance.png"
                        Aspect="AspectFill"
                        HeightRequest="180"
                        SemanticProperties.Description="Belgium Campus entrance sign" />
                    <Label
                        Grid.Row="1"
                        Text="Point your camera at a campus building to see its name, or look around a place in 360°."
                        Style="{StaticResource CardTitleLabel}"
                        FontSize="18" />
                    <Button Grid.Row="2" Text="Open AR camera" Command="{Binding OpenArCommand}" />
                    <Button
                        Grid.Row="3"
                        Text="Open 360° view"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenPanoramaCommand}" />
                </Grid>
            </Border>

            <Label
                Text="The AR camera works best outdoors and uses your camera, GPS and compass. To jump straight to a place's 360° view, type its location code (shown on each location) or choose it from the list."
                Style="{StaticResource MutedLabel}" />

            <Entry
                Placeholder="e.g. BC-LIBRARY"
                Text="{Binding Code}"
                MaxLength="40"
                ReturnType="Go"
                ReturnCommand="{Binding OpenCodeCommand}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False" />

            <Button Text="Enter code manually" Command="{Binding OpenCodeCommand}" />
            <Button
                Text="Choose from locations"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ChooseLocationCommand}" />

            <!-- Staff only: both ask for the staff sign-in first. -->
            <Label Text="Staff" Style="{StaticResource SectionTitleLabel}" />
            <Label
                Text="Signed-in staff can add new places. You are asked to sign in first."
                Style="{StaticResource MutedLabel}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Text="New AR scan"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NewArScanCommand}" />
                <Button
                    Grid.Column="1"
                    Text="New 360° view"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NewPanoramaCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
