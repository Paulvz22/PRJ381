<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BCOpendayApp.Views.Controls.InfoCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">

    <!-- A card with a heading and a paragraph (How it works, Visitor information). -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
            <Label
                Text="{Binding Heading, Source={x:Reference root}}"
                TextColor="{Binding HeadingColor, Source={x:Reference root}}"
                Style="{StaticResource CardTitleLabel}"
                SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Body, Source={x:Reference root}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
