<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BCOpendayApp.Views.Controls.MenuTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">

    <!-- Home-screen tile: icon above a button. -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
            <Image
                Source="{Binding Icon, Source={x:Reference root}}"
                Aspect="AspectFit"
                HeightRequest="44"
                SemanticProperties.Description="{Binding Text, Source={x:Reference root}}" />
            <Button
                Text="{Binding Text, Source={x:Reference root}}"
                Command="{Binding Command, Source={x:Reference root}}"
                Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
