<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BCOpendayApp.Views.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root">

    <!-- Brand line + big title + subtitle shown at the top of every page. -->
    <VerticalStackLayout Spacing="18">
        <Label Text="BELGIUM CAMPUS / OPEN DAY" Style="{StaticResource EyebrowLabel}" />
        <Label
            Text="{Binding Title, Source={x:Reference root}}"
            Style="{StaticResource PageTitleLabel}"
            SemanticProperties.HeadingLevel="Level1" />
        <Label
            Text="{Binding Subtitle, Source={x:Reference root}}"
            Style="{StaticResource MutedLabel}"
            IsVisible="{Binding HasSubtitle, Source={x:Reference root}}" />
    </VerticalStackLayout>
</ContentView>
