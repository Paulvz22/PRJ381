<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BCOpendayApp.Views.Controls.CatalogStatusView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BCOpendayApp.ViewModels"
    x:DataType="vm:CatalogViewModelBase">

    <!-- Where the stop data came from + a Refresh button + a spinner while the first load runs.
         Put it on any page whose view model derives from CatalogViewModelBase (it binds to the page's view model). -->
    <VerticalStackLayout Spacing="8">
        <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" FontSize="13" />
        <ActivityIndicator
            IsRunning="{Binding ShowSpinner}"
            IsVisible="{Binding ShowSpinner}"
            Color="{StaticResource BcRed}" />
        <Button
            Text="Refresh locations"
            Style="{StaticResource SecondaryButton}"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsNotLoading}" />
    </VerticalStackLayout>
</ContentView>
