<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="BCOpendayApp.Panorama.Views.PanoramaDraftsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BCOpendayApp.Views.Controls"
    xmlns:views="clr-namespace:BCOpendayApp.Views"
    xmlns:vm="clr-namespace:BCOpendayApp.Panorama.ViewModels"
    x:DataType="vm:PanoramaDraftsViewModel"
    Title="360° views (staff)"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">

            <controls:PageHeader
                Title="360° views"
                Subtitle="Capture a new view with the camera, or import a finished 2:1 panorama." />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Capture with this phone" Style="{StaticResource CardTitleLabel}" />
                    <Label
                        Text="Stand on the spot, turn slowly on the spot and the app takes the photos and joins them. The GPS position is saved too, so arrows to nearby views appear automatically."
                        Style="{StaticResource MutedLabel}" />
                    <Button
                        Text="+ Capture new 360° view"
                        Command="{Binding CaptureCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <Button
                        Text="Open 360° tour with arrows"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenTourCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Import a finished panorama" Style="{StaticResource CardTitleLabel}" />
                    <Label
                        Text="Views are saved on this phone first. Use Upload to put a view online for every visitor."
                        Style="{StaticResource MutedLabel}" />
                    <Button
                        Text="Choose panorama image"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <Label
                        Text="JPEG or PNG, about 2:1 (for example 4096 × 2048), up to 20 MB. A normal photo or partial panorama is rejected."
                        Style="{StaticResource MutedLabel}"
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BcRed}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" FontSize="13" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasPending}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Preview before saving" Style="{StaticResource CardTitleLabel}" />
                    <Image
                        Source="{Binding PendingPreviewPath}"
                        Aspect="AspectFit"
                        HeightRequest="220"
                        SemanticProperties.Description="Flattened preview of the selected panorama" />
                    <Label Text="{Binding PendingName}" Style="{StaticResource EyebrowLabel}" />
                    <Label Text="{Binding PendingDetails}" Style="{StaticResource MutedLabel}" FontSize="13" />
                    <Button
                        Text="Save as local draft"
                        Command="{Binding SavePendingCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                    <Button
                        Text="Discard preview"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DiscardPendingCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Saved drafts" Style="{StaticResource SectionTitleLabel}" />
            <Label
                Text="No local drafts yet."
                Style="{StaticResource MutedLabel}"
                IsVisible="{Binding HasNoDrafts}" />

            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Drafts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PanoramaDraftItem">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding DisplayName}" Style="{StaticResource CardTitleLabel}" FontSize="18" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Badge}"
                                        Style="{StaticResource EyebrowLabel}"
                                        FontSize="11"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Details}" Style="{StaticResource MutedLabel}" FontSize="13" />
                                <Label Text="{Binding Placement}" Style="{StaticResource MutedLabel}" FontSize="13" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <Button
                                        Text="{Binding UploadText}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanoramaDraftsViewModel}}, Path=UploadCommand}"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Open"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanoramaDraftsViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Grid.Row="1"
                                        Text="Export"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanoramaDraftsViewModel}}, Path=ExportCommand}"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Delete"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanoramaDraftsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Views in Firestore: every visitor's 360° tour shows these. -->
            <Label Text="Online views" Style="{StaticResource SectionTitleLabel}" />
            <Label Text="{Binding OnlineStatus}" Style="{StaticResource MutedLabel}" FontSize="13" />
            <Label
                Text="Nothing online yet. Use Upload on a view above."
                Style="{StaticResource MutedLabel}"
                IsVisible="{Binding HasNoOnlineViews}" />
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding OnlineViews}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnlinePanoramaItem">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitleLabel}" FontSize="17" />
                                <Label Grid.Row="1" Text="{Binding Details}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                <Button
                                    Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Text="Remove"
                                    Style="{StaticResource SecondaryButton}"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PanoramaDraftsViewModel}}, Path=DeleteOnlineCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
