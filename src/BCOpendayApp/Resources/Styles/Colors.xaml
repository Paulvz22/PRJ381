<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Belgium Campus brand palette. The app is dark-only (see App.xaml.cs). -->
    <Color x:Key="BcRed">#FA262A</Color>
    <Color x:Key="BcRedDark">#B91C20</Color>
    <Color x:Key="BcYellow">#FFD400</Color>
    <Color x:Key="BcTextMuted">#B7B7B7</Color>

    <Color x:Key="PageBackground">#08090B</Color>
    <Color x:Key="NavBarBackground">#0D0D0D</Color>
    <Color x:Key="CardBackground">#15171C</Color>
    <Color x:Key="CardBorder">#30333B</Color>
    <Color x:Key="SecondaryButtonBackground">#24262C</Color>

    <SolidColorBrush x:Key="BcRedBrush" Color="{StaticResource BcRed}" />
    <SolidColorBrush x:Key="BcYellowBrush" Color="{StaticResource BcYellow}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />

</ResourceDictionary>
