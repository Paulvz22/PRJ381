<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Order matters: a style can only be BasedOn a style that is defined ABOVE it. -->

    <!-- ===== Pages ===== -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>

    <!-- The scrolling column every page puts its content in. -->
    <Style x:Key="PageContent" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="18" />
        <Setter Property="Padding" Value="20,18,20,28" />
        <Setter Property="MaximumWidthRequest" Value="700" />
    </Style>

    <!-- ===== Text ===== -->
    <!-- Base look for all text. In MAUI an explicit Style="..." REPLACES the implicit style instead of
         adding to it, so every keyed label style below is BasedOn BodyLabel to keep colour + font. -->
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Any Label without an explicit Style is body text. -->
    <Style TargetType="Label" BasedOn="{StaticResource BodyLabel}" />

    <Style x:Key="PageTitleLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="30" />
    </Style>

    <Style x:Key="SectionTitleLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="CardTitleLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="21" />
    </Style>

    <Style x:Key="EyebrowLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource BcRed}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource BcTextMuted}" />
    </Style>

    <Style x:Key="AccentLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{StaticResource BcYellow}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BcRed}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryButtonBackground}" />
    </Style>

    <!-- Any Button without an explicit Style is a primary button. -->
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <!-- ===== Containers ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BcTextMuted}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BcTextMuted}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource BcRed}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource BcRed}" />
        <Setter Property="ThumbColor" Value="{StaticResource BcYellow}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource BcYellow}" />
    </Style>

</ResourceDictionary>
