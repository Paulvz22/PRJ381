# Normalise line endings so Windows and macOS teammates don't produce whole-file diffs.
* text=auto

# Source / config - always text
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.props     text
*.targets   text
*.sln       text eol=crlf
*.json      text
*.xml       text
*.svg       text
*.md        text
*.plist     text
*.config    text
*.editorconfig text

# Binary assets - never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.zip       binary
